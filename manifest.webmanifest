{
  "name": "OneRepMaximus",
  "short_name": "OneRepMaximus",
  "description": "Log your workouts, get move-up calls, muscle balance and a weekly plan.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#0E0F11",
  "theme_color": "#0E0F11",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./share",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [
        { "name": "file", "accept": ["text/csv", "text/comma-separated-values", "text/plain", ".csv"] }
      ]
    }
  }
}
